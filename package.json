{
  "name": "ieec-ya-connect",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @ieec/web",
    "build": "npm run build:web",
    "build:web": "npm run build -w @ieec/web",
    "dev:mobile": "npm run start -w @ieec/mobile",
    "build:shared": "npm run build -w @ieec/shared",
    "typecheck": "npm run typecheck -w @ieec/shared && npm run typecheck -w @ieec/web",
    "emulators": "npx -y firebase-tools@14.11.0 emulators:start --only auth,firestore --project ieec-ya-connect",
    "seed:emulator": "npm install --prefix scripts && node scripts/seed-firebase-emulator.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
