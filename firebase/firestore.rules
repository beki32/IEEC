rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Public newcomer form (no login).
    match /publicRegistrations/{id} {
      allow create: if true
        && request.resource.data.keys().hasAll(['organizationId', 'firstName', 'lastName', 'email', 'phone'])
        && !request.resource.data.keys().hasAny(['currentMinistryStatus', 'hasUserAccount', 'roleTemplateId']);
      allow read, update, delete: if false;
    }

    // TEMP MVP: any signed-in staff can read/write.
    // Tighten to org-scoped RBAC after first successful production login.
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
