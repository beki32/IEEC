# Default: local demo store (no Firebase required)
VITE_USE_DEMO=true

# Set VITE_USE_DEMO=false and fill Firebase values to use Auth + Firestore.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=ieec-ya-connect.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ieec-ya-connect
VITE_FIREBASE_STORAGE_BUCKET=ieec-ya-connect.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo

# Local emulators (after: npm run emulators)
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

# Public landing — Instagram profile (no @). Embed + follow link use this handle.
VITE_INSTAGRAM_HANDLE=ieecya
