{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm install --workspace=@ieec/web --workspace=@ieec/shared",
  "buildCommand": "cd ../.. && npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!presentations/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
